---
---
<section
  id="about"
  data-accent="255 255 255"
  class="relative min-h-screen flex flex-col justify-center px-6 pt-24 pb-16 max-w-6xl mx-auto"
>
  <!-- Subtle grid background -->
  <div class="absolute inset-0 -z-10 pointer-events-none" aria-hidden>
    <div
      style="background-image: linear-gradient(rgba(255,255,255,0.025) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.025) 1px, transparent 1px); background-size: 60px 60px;"
      class="absolute inset-0"
    ></div>
    <div class="absolute inset-0" style="background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(12,12,15,0) 0%, #0c0c0f 70%)"></div>
  </div>

  <div class="max-w-3xl">
    <p class="reveal font-mono text-sm text-white/30 tracking-widest mb-6 uppercase">
      Welcome, I am
    </p>
    <h1 class="reveal reveal-delay-1 text-5xl md:text-7xl font-light leading-tight tracking-tight text-white mb-6">
      Andrés Sevilla,<br />
      <span class="text-white/40">mathematician</span><br />
      <span class="text-white/25">&amp; software developer.</span>
    </h1>
    <p class="reveal reveal-delay-2 text-lg text-white/50 leading-relaxed max-w-xl mb-4">
      I like building any type of real time interactive system such as simulations, scientific visualizations and games. 
    </p>
    <p class="reveal reveal-delay-2 text-base text-white/35 leading-relaxed max-w-xl mb-10">
       C# · Unity · HLSL · C++ · OpenGL · GLSL · TouchDesigner · Python · Scientific Computing. 
    </p>
    <p class="reveal reveal-delay-2 text-base text-white/35 leading-relaxed max-w-xl mb-10">
       Check out my work!
    </p>
    <div class="reveal reveal-delay-3 flex flex-wrap gap-2 mb-6">
      {[
        { label: 'Academic',     href: '#academic',      c: '59 130 246'  },
        { label: 'Professional', href: '#professional',  c: '249 115 22'  },
        { label: 'Education',    href: '#education',     c: '34 197 94'   },
        { label: 'Personal',     href: '#personal',      c: '168 85 247'  },
        { label: 'Demos',        href: '#demos',         c: '236 72 153'  },
      ].map(link => (
        <a
          href={link.href}
          style={`--lc:${link.c}`}
          class="hero-pill text-xs tracking-widest px-3 py-1 rounded-sm border text-white bg-black active:scale-95 transition-[border-color,background-color,transform] duration-150"
        >
          {link.label}
        </a>
      ))}
    </div>
    <a
      href="mailto:andressevilla81@gmail.com"
      class="reveal reveal-delay-3 text-sm text-white/35 hover:text-white/60 transition-colors duration-200 tracking-wide font-mono"
    >
      andressevilla81@gmail.com ↗
    </a>
  </div>

  <style>
    .hero-pill { border-color: rgb(var(--lc) / 0.4); }
    .hero-pill:hover { border-color: rgb(var(--lc) / 0.9); background-color: rgb(var(--lc) / 0.12); }
  </style>

  <div class="absolute bottom-10 left-6 flex items-center gap-3 text-white/20">
    <div class="w-px h-12 bg-white/10"></div>
    <span class="text-xs font-mono tracking-widest uppercase">Scroll</span>
  </div>
</section>
