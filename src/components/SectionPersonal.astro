---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import SectionCanvas from './SectionCanvas.astro';
import { NEBULA_PIXEL } from '../shaders';
const base = import.meta.env.BASE_URL;
---
<section
  id="personal"
  data-accent="168 85 247"
  class="relative py-24 px-6 max-w-6xl mx-auto overflow-hidden"
>
  <SectionCanvas frag={NEBULA_PIXEL} opacity={0.45} />

  <div style="position:relative;z-index:1">
  <SectionHeader
    index="04"
    title="Personal Projects"
    subtitle="Real-time rendering systems, generative simulations, and shader pipelines built out of curiosity."
  />

  <div class="grid md:grid-cols-2 gap-4">
    <!-- GridSpace — merged wide card with both GIFs -->
    <article class="reveal group relative border border-white/[0.08] rounded-sm transition-all duration-300 overflow-hidden md:col-span-2 hover:border-[color:rgb(var(--accent)/0.35)] hover:bg-[color:rgb(var(--accent)/0.05)]">
      <div class="grid grid-cols-2 border-b border-white/[0.06]">
        <img src={`${base}gridspace1.gif`} alt="GridSpace mutation mode" class="w-full aspect-video object-cover opacity-75 group-hover:opacity-95 transition-opacity duration-300 border-r border-white/[0.06]" loading="lazy" />
        <img src={`${base}gridspace2.gif`} alt="GridSpace neighborhood picker" class="w-full aspect-video object-cover opacity-75 group-hover:opacity-95 transition-opacity duration-300" loading="lazy" />
      </div>
      <div class="p-6">
        <div class="flex items-start justify-between gap-4 mb-3">
          <h3 class="font-mono text-xs tracking-widest px-2.5 py-1 rounded-sm border border-[color:rgb(var(--accent)/0.6)] bg-[color:rgb(var(--accent)/0.08)] text-white/85 group-hover:text-white group-hover:border-[color:rgb(var(--accent)/0.9)] group-hover:bg-[color:rgb(var(--accent)/0.15)] transition-colors">GridSpace — Cellular Automata Engine</h3>
          <div class="flex items-center gap-3 shrink-0">
            <a href="https://github.com/andressev/GridSpacee" target="_blank" rel="noopener noreferrer" class="text-xs text-white/30 hover:text-[color:rgb(var(--accent))] transition-colors border border-white/[0.08] px-2 py-0.5 rounded-sm hover:border-[color:rgb(var(--accent)/0.4)]">GitHub ↗</a>
            <a href="https://www.youtube.com/watch?v=BqFUAaOdQgY" target="_blank" rel="noopener noreferrer" class="text-xs text-white/30 hover:text-[color:rgb(var(--accent))] transition-colors border border-white/[0.08] px-2 py-0.5 rounded-sm hover:border-[color:rgb(var(--accent)/0.4)]">Video ↗</a>
          </div>
        </div>
        <p class="text-sm text-white/45 leading-relaxed mb-4">GPU-parallel cellular automata engine written in HLSL. Cellular automata only become interesting at scale — so the entire simulation runs on the GPU via compute shaders, not the CPU. Users compose up to 4 rule sets with custom neighborhood kernels and mutate them in real time. The state space has 10³⁰⁸ configurations — the number of atoms in the observable universe is 10⁸⁰.</p>
        <div class="flex flex-wrap gap-2">
          {["HLSL", "GPU Compute", "Parallel Simulation", "Procedural Generation", "C#"].map(t => (
            <span class="font-mono text-xs px-2 py-0.5 rounded-sm bg-white/[0.05] text-white/35 border border-white/[0.08]">{t}</span>
          ))}
        </div>
      </div>
      <div class="absolute left-0 top-4 bottom-4 w-px bg-[color:rgb(var(--accent))] opacity-0 group-hover:opacity-50 transition-opacity duration-300 rounded-full"></div>
    </article>
    <ProjectCard
      title="Pointcloud — Gravity Simulation"
      video="https://github.com/user-attachments/assets/5176f8b3-8e50-479f-a63c-6b3ed25c5d67"
      description="Spacetime curvature rendered as a point cloud. ~200,000 points represent 3D space — each displaced by a gravitational potential field centered on a massive body. The compression gradient toward the center is physically derived, not aesthetic. Written in GLSL inside TouchDesigner."
      tags={["GLSL", "Fragment Shader", "Scientific Visualization", "Point Cloud", "TouchDesigner"]}
    />
    <ProjectCard
      title="Spherical Gravity"
      video="https://github.com/user-attachments/assets/4e5555e4-b39c-4b27-b432-19360064908a"
      description="Extension of the gravity simulation — a angular transformation applied relative to the origin breaks the physical model into something purely generative. Same 200,000-point system, same GLSL pipeline, pushed into abstract territory."
      tags={["GLSL", "Fragment Shader", "Generative Systems", "TouchDesigner"]}
    />
    <ProjectCard
      title="Mandelbrot Explorer"
      video={`${base}MandelS.mov`}
      description="Interactive Mandelbrot set explorer built as a GLSL fragment shader in TouchDesigner. Extended to be audio-reactive — frequency and amplitude data drive the iteration parameters and color mapping in real time, turning sound into geometry."
      tags={["GLSL", "Fragment Shader", "Procedural Generation", "Audio-Reactive", "TouchDesigner"]}
    />
    <ProjectCard
      title="Mandelbrot 3D — Raymarched"
      video="https://github.com/user-attachments/assets/5d88fa54-8d69-4e60-a4db-23ef1f518690"
      description="Mandelbulb rendered entirely in a GLSL fragment shader via raymarching. Adapted an existing distance estimator for the 3D Mandelbrot set, then built everything around it: the ray-march loop, surface normals derived from the SDF gradient, a lighting model with ambient occlusion, and a camera system — all running in real time inside TouchDesigner."
      tags={["GLSL", "Raymarching", "Signed Distance Functions", "Real-time Rendering", "TouchDesigner"]}
    />
  </div>
  </div>
</section>
