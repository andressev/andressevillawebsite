---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
---
<section
  id="math"
  data-accent="234 179 8"
  class="py-24 px-6 max-w-6xl mx-auto"
>
  <SectionHeader
    index="05"
    title="Mathematical Projects"
    subtitle="Personal explorations in pure and applied mathematics — implemented, visualized, and pushed until they break."
  />

  <div class="grid md:grid-cols-2 gap-4">
    <ProjectCard
      highlight
      title="Mathematical Visualizations"
      description="Interactive visualizations of complex mathematical concepts — manifolds, algebraic structures, and dynamical systems rendered in real time."
      tags={["Math", "Visualization", "GLSL", "WebGL"]}
    />
    <ProjectCard
      title="Dynamical Systems & Chaos"
      description="Exploration of chaotic systems — Lorenz attractors, bifurcation diagrams, and sensitivity to initial conditions. Built tools to navigate parameter spaces interactively."
      tags={["Chaos Theory", "Dynamical Systems", "Python"]}
    />
    <ProjectCard
      title="Number Theory Experiments"
      description="Computational experiments in number theory — prime distributions, modular arithmetic patterns, and Collatz-type sequences visualized at scale."
      tags={["Number Theory", "Computation", "Python"]}
    />
    <ProjectCard
      title="Geometry & Topology Tools"
      description="Programs for exploring geometric and topological structures — mesh operations, Möbius transformations, and surface parametrizations."
      tags={["Geometry", "Topology", "Linear Algebra", "C++"]}
    />
    <ProjectCard
      title="Fourier & Signal Analysis"
      description="Implementations of Fourier analysis applied to images, audio, and arbitrary signals — with interactive frequency-domain editing."
      tags={["Fourier", "Signal Processing", "Python", "FFT"]}
    />
  </div>
</section>
