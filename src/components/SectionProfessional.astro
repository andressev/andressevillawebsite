---
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
const base = import.meta.env.BASE_URL;
---
<section
  id="professional"
  data-accent="249 115 22"
  class="py-24 px-6 max-w-6xl mx-auto"
>
  <SectionHeader
    index="02"
    title="Professional Work"
    subtitle="Shipped commercial titles on Apple Arcade, real teams, strict standards, iterating versions with a quality assurance team until reaching high standards."
  />

  <div class="grid md:grid-cols-2 gap-4">
    <ProjectCard
      highlight
      title="Pocket City 2+"
      year="2024"
      image="https://github.com/user-attachments/assets/d5c2dac6-6979-4c55-90ae-14df5ae64b75"
      description="Pocket City 2 was a famous building tycoon game on the appstore, when Apple Arcade chose them to be the next game on their plattform many changes and features had to be integrated to the game. I led the technical integration: designed an automatic cross-device iCloud backup and recovery system, implemented platform-specific functionality across iOS, macOS, tvOS, and visionOS, and brought the full experience up to Apple's certification standards."
      tags={["Unity", "C#", "Apple Arcade", "Cross-Platform", "external plugins", "Backend", "memory managment"  ]}
      links={[
        { label: "App Store", href: "https://apps.apple.com/us/app/pocket-city-2/id1533709428" },
        { label: "Steam", href: "https://store.steampowered.com/app/3566200/Pocket_City_2/" }
      ]}
    />
    <ProjectCard
      title="Farmside"
      year="2024"
      image="https://github.com/user-attachments/assets/0f7c4a1b-c1e5-4a70-bebc-40ec1bd7e252"
      description="Delivered a major update for Farmside, another large-scale Apple Arcade title. Production at this scale means every change touches thousands of users, extreme care, fast execution, and tight deadlines."
      tags={["Unity", "C#", "Apple Arcade", "Production"]}
      links={[
        { label: "Farmside", href: "https://farmsidegame.com/" }
      ]}
    />
    <ProjectCard
      title="Moshpit"
      year="2024"
      image={`${base}Screenshot 2026-05-15 184058.png`}
      description="Designed and implemented a portion of the UI system for Moshpit. The project required mastering Unity Addressables,  async asset bundle loading, runtime instantiation, and memory management."
      tags={["Unity", "C#", "UI Systems", "Addressables", "Runtime Asset Loading"]}
    />
    <ProjectCard
      title="VR Interior Design Experience"
      year="2024"
      video={`${base}vr-interior.mp4`}
      videoPoster={`${base}vr-interior-poster.jpg`}
      videoStart={3}
      wide={true}
      description="Built a real-time VR walkthroughs for an interior design firm's clients projects. High fidelity was extremeley important so I worked throughout Unity's HDRP rendering pipeline: physically-based reflections, emissive surfaces, area lights, and hybrid baked/real-time global illumination to make the expirience hyper realistic"
      tags={["Unity", "HDRP", "Real-time Rendering", "VR", "Spatial Computing", "Lighting", "hyper realistic"]}
    />
  </div>
</section>
